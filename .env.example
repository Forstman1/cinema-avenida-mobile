# Public API address only; do not put tokens or other secrets in EXPO_PUBLIC_* variables.
# Web and iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# Physical Android/iOS device (replace with the development machine's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
